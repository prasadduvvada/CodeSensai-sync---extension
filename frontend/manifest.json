{
  "manifest_version": 3,
  "name": "DSA Mentor",
  "version": "1.0.0",
  "description": "AI-powered DSA companion",
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DSA Mentor"
  },

  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "http://localhost:8080/*"
  ],
  
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*"
      ],
      "js": ["src/content.tsx"],
      "run_at": "document_start"
    }
  ],
  
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  
  "permissions": [
    "identity",
    "storage"
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://leetcode.com/*", "https://*.leetcode.com/*"]
    }
  ]
}